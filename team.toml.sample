# Your formation: the operator and the members, each on its own harness and model. The operator is the lead
# agent; you, the user, are the owner who directs it. This file is yours and is not committed;
# team.toml.sample is the project's suggestion. All roles are in the skill's roles/.
# A member needs harness + model; thinking defaults to its role's. Optional per member: role (for numbered
# names), notes (what it owns here), permissions, args (native flags), worktree (true: its own checkout on
# branch <user>/<name>; a branch name: that branch). The first member of a role has the role's name; more of
# that role are -2, -3, ... A name never changes.

# user = "peter"          # the first part of your worktree branches (peter/lead-dev); default: your system user
#                         # name. A top-level key: it goes here, above [operator]. Leave it out of team.toml.sample.
# permissions = "guarded" # default "full": members never stop for approval, which assumes a safe machine.
#                         # guarded keeps Claude Code and Codex behind their own guard. See SKILL.md.
# worktree_dir = "../<repo>.worktrees"

[operator]
name = "operator"   # the operator agent's @name, pane label and herdr agent name; fixed while the team runs
harness = "claude"
model = "claude-opus-5-5"
thinking = "medium"
notes = "Decides scope and architecture, assigns tasks, reviews and commits to master."

[members.architect]
harness = "claude"
model = "claude-fable-5-2"
thinking = "high"
notes = "Standing design adviser for the skill: keeps ateam.py, the roles, references and templates simple and coherent. Any member may consult it. Writes plans only, never code."

[members.lead-dev]
harness = "codex"
model = "gpt-6-astra"
thinking = "high"
notes = "Implements changes to scripts/ateam.py, roles/, references/, templates/ and SKILL.md, with tests in scripts/test_ateam.py."

[members.reviewer]
harness = "codex"
model = "gpt-6-luna"
thinking = "high"
notes = "Reviews each diff, runs python3 scripts/test_ateam.py, and checks that SKILL.md, README.md and references/ still match the behaviour."

[members.pm]
harness = "pi"
model = "deepseek/deepseek-v4.1-flash"
thinking = "high"
notes = "Owns the GitHub Issues tracker on pkieltyka/herdr-a-team through the todos CLI."
