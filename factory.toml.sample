[operator]
name = "operator"
notes = "Decides scope and architecture, assigns tasks, reviews and commits to master."

[members.architect]
harness = "claude"
model = "claude-fable-5-2"
thinking = "high"
notes = "Standing design adviser for the skill: keeps skill/scripts/factory.py, the roles, references and templates simple and coherent. Any member may consult it. Writes plans only, never code."

[members.lead-dev]
harness = "codex"
model = "gpt-6.2-sol"
thinking = "high"
worktree = true
notes = "Implements changes to skill/scripts/factory.py and skill/ (roles, references, templates, SKILL.md), with tests in tests/test_factory.py."

[members.reviewer]
harness = "codex"
model = "gpt-6.1-terra"
thinking = "high"
notes = "Reviews each diff, runs python3 tests/test_factory.py, and checks that skill/SKILL.md, README.md and skill/references/ still match the behaviour."

[members.pm]
harness = "omp"
model = "openai-codex/gpt-6-luna"
thinking = "high"
notes = "Owns the TODO.md tracker at the repo root."

[members.lead-dev-2]
role = "lead-dev"
harness = "claude"
model = "claude-opus-5-5"
thinking = "high"
worktree = true
notes = "Second lead-dev on Claude Code (Opus 5.5 high)."

